# ── Nexora / نکسورا — نمونهٔ متغیرهای محیطی ─────────────────────────────
# این فایل فقط «نمونه» است و هیچ مقدار واقعی/محرمانه‌ای داخلش نیست.
# برای اجرای محلی کافیست کپی کنی:  cp .env.example .env.local
# بدون این متغیرها هم اپ بالا می‌آید (PGlite محلی + کلید توسعه)، فقط برای
# دیتابیس واقعی و امنیت پروداکشن باید مقدار بدهی.

# اتصال Postgres (مثلاً Neon). خالی بماند → PGlite درون‌حافظه‌ای استفاده می‌شود.
DATABASE_URL=

# کلید امضای کوکی نشست و کوکی پنل مدیریت (یک رشتهٔ تصادفی طولانی بگذار).
NEXORA_SECRET=

# رمز ورود پنل /adminn — اگر خالی باشد پیش‌فرض «ali026» استفاده می‌شود.
NEXORA_ADMIN_PASSWORD=

# برای تست محلی با PGlite حتی وقتی DATABASE_URL ست شده باشد:
# NEXORA_FORCE_PGLITE=1
